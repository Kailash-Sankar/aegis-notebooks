# --- Runner ---
PORT=8787
WORKSPACES_ROOT=../workspaces

# --- Model (Pi) ---
# Set ONE provider key. See Pi docs: docs/providers.md
OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
#
# AEGIS_MODEL is "provider/model-id" (split on the FIRST slash).
# (Named AEGIS_*, not PI_*, so the Pi agent's own PI_* vars cannot override it.)
# List available models with: npm run models
# Examples:
#   AEGIS_MODEL=openrouter/anthropic/claude-sonnet-4.5
#   AEGIS_MODEL=openrouter/openai/gpt-4o-mini
# Leave unset to use the first model with valid credentials.
AEGIS_MODEL=
AEGIS_THINKING=medium

# --- PocketBase (registry) ---
POCKETBASE_URL=http://127.0.0.1:8090
POCKETBASE_ADMIN_EMAIL=
POCKETBASE_ADMIN_PASSWORD=

# --- RustFS (recovery set). Leave unset to skip backups. ---
RUSTFS_ENDPOINT=
RUSTFS_REGION=us-east-1
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=
RUSTFS_BUCKET=aegis-backups
# Raw lake authority (ADR 0007): separate bucket, same RustFS instance.
RUSTFS_RAW_BUCKET=aegis-raw

# --- Broker (Redpanda / Kafka API). Unset => in-process MemoryBroker. ---
# Comma-separated. In compose use the service name; on the host use 127.0.0.1:9092.
KAFKA_BROKERS=
KAFKA_CLIENT_ID=aegis-runner

# --- ClickHouse warehouse (Phase 2+) ---
CLICKHOUSE_URL=
CLICKHOUSE_DB=aegis
CLICKHOUSE_USER=aegis
CLICKHOUSE_PASSWORD=aegis-dev-password

# --- Inngest (control plane). Unset => the chunk bridge loads inline. ---
INNGEST_BASE_URL=
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- Quotas (ADR 0005) ---
QUOTA_TOTAL_BYTES=10737418240
QUOTA_FILE_BYTES=1073741824
QUOTA_FILE_COUNT=500
QUOTA_WIDGET_ROWS=100000

# --- DuckDB ---
DUCKDB_CLI=duckdb
