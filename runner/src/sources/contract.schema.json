{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aegis.local/schemas/source-contract.schema.json",
  "title": "Aegis Source Contract",
  "description": "Declarative description of how to pull and shape one source dataset. Agent-bootstrapped, deterministically executed.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "source", "dataset", "baseUrl", "sync", "load", "columns"],
  "properties": {
    "version": { "const": 1 },
    "source": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$" },
    "dataset": { "type": "string", "minLength": 1 },
    "baseUrl": { "type": "string", "minLength": 1 },
    "sync": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "endpoint", "pageSize"],
      "properties": {
        "mode": { "enum": ["full", "incremental"] },
        "endpoint": { "type": "string", "minLength": 1 },
        "cursorField": { "type": "string" },
        "cursorParam": { "type": "string" },
        "pageSize": { "type": "integer", "minimum": 1 }
      },
      "allOf": [
        {
          "if": {
            "properties": { "mode": { "const": "incremental" } },
            "required": ["mode"]
          },
          "then": { "required": ["cursorField"] }
        }
      ]
    },
    "load": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "layer", "mode", "dedupe", "key"],
      "properties": {
        "target": { "const": "clickhouse" },
        "layer": { "const": "ingested" },
        "mode": { "enum": ["append", "upsert"] },
        "dedupe": { "enum": ["latest_by_key", "none"] },
        "key": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    },
    "columns": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type"],
        "properties": {
          "type": { "type": "string", "minLength": 1 },
          "eventTime": { "type": "boolean" },
          "pii": { "type": "boolean" }
        }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "notNull": { "type": "array", "items": { "type": "string" } },
        "unique": { "type": "array", "items": { "type": "string" } }
      }
    },
    "physical": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "partitionBy": { "type": "string" },
        "orderBy": { "type": "array", "items": { "type": "string" } }
      }
    },
    "auth": {
      "description": "How to authenticate to the source. The secret value is never stored here — only a reference name resolved from the environment or a gitignored credentials file.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "enum": ["none", "bearer", "header", "basic", "query"] },
        "secretRef": { "type": "string", "minLength": 1 },
        "header": { "type": "string", "minLength": 1 },
        "param": { "type": "string", "minLength": 1 },
        "usernameRef": { "type": "string", "minLength": 1 },
        "passwordRef": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "bearer" } }, "required": ["type"] },
          "then": { "required": ["secretRef"] }
        },
        {
          "if": { "properties": { "type": { "const": "header" } }, "required": ["type"] },
          "then": { "required": ["header", "secretRef"] }
        },
        {
          "if": { "properties": { "type": { "const": "query" } }, "required": ["type"] },
          "then": { "required": ["param", "secretRef"] }
        },
        {
          "if": { "properties": { "type": { "const": "basic" } }, "required": ["type"] },
          "then": { "required": ["usernameRef", "passwordRef"] }
        }
      ]
    }
  }
}
